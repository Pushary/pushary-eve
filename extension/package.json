{
  "name": "@pushary/eve-extension",
  "version": "0.1.4",
  "description": "Pushary extension for Eve: ask a real human on their phone and block on a fail-closed answer.",
  "author": "Pushary <business@pushary.com>",
  "homepage": "https://pushary.com/human-in-the-loop-eve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pushary/pushary-eve.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/Pushary/pushary-eve/issues"
  },
  "license": "MIT",
  "type": "module",
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@pushary/eve": "^0.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eve": "^0.44.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "eve": ">=0.31.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pushary",
    "eve",
    "eve.dev",
    "eve-extension",
    "human-in-the-loop",
    "hitl",
    "approval",
    "agent"
  ],
  "engines": {
    "node": ">=24"
  }
}
